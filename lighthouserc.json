{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "PORT=$PORT npm start",
      "startServerReadyPattern": "YESorNOaaS listening",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:$PORT/yes",
        "http://localhost:$PORT/no",
        "http://localhost:$PORT/random"
      ]
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

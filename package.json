{
  "name": "@ravidor/yornaas",
  "version": "1.0.3",
  "description": "Yes or No as a Service: call /api/yes or /api/no for Yes! or No!",
  "license": "MIT",
  "type": "module",
  "main": "src/server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravidorr/yes-or-no-as-a-service.git"
  },
  "bugs": {
    "url": "https://github.com/ravidorr/yes-or-no-as-a-service/issues"
  },
  "homepage": "https://github.com/ravidorr/yes-or-no-as-a-service#readme",
  "keywords": [
    "yornaas",
    "yaas",
    "naas",
    "yes",
    "no",
    "mcp",
    "cli",
    "express"
  ],
  "files": [
    "src/",
    "public/",
    "scripts/prepare-husky.mjs",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "yornaas": "src/cli.js",
    "yornaas-mcp": "src/mcp.js"
  },
  "scripts": {
    "mcp": "node src/mcp.js",
    "prepare": "node scripts/prepare-husky.mjs",
    "prepublishOnly": "npm run test:coverage",
    "start": "node src/server.js",
    "test": "node --test",
    "test:coverage": "node scripts/run-coverage.mjs",
    "test:e2e": "playwright test",
    "test:package": "node scripts/smoke-tarball.mjs",
    "lint": "npm run lint:js && npm run lint:html && npm run lint:md",
    "lint:js": "eslint .",
    "lint:html": "html-validate public/*.html",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#test-results\"",
    "verify:release-notes": "node scripts/verify-release-notes.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prometheus-io/client": "^0.16.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "html-validate": "^11.0.0",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.23.3",
    "yaml": "^2.8.1"
  }
}
